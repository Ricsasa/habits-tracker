      "setup": "Ejecutar SQL schema en SQL Editor"
    },
    "pwa": {
      "installable": true,
      "offlineSupport": true,
      "manifest": "public/manifest.json"
    },
    "cost": {
      "frontend": "$0 (Vercel tier gratuito)",
      "database": "$0 (Supabase tier gratuito)",
      "total": "$0/mes"
    }
  },

  "developmentWorkflow": {
    "phase1": {
      "name": "Agent Backend Setup & Database",
      "estimatedTime": "2-3 horas",
      "tasks": [
        "SQL schema + RLS policies",
        "lib/types.ts",
        "lib/supabase.ts",
        "API routes (15 endpoints)"
