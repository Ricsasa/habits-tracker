    "phase2": {
      "name": "Agent Frontend Components & Pages",
      "estimatedTime": "4-5 horas",
      "tasks": [
        "i18n setup",
        "Components (atoms, molecules, organisms)",
        "Pages (auth, dashboard, reports, settings)",
        "Dark mode + responsividad"
      ]
    },
    "phase3": {
      "name": "Integration & Testing",
      "estimatedTime": "1-2 horas",
      "tasks": [
        "End-to-end testing",
        "PWA manifest",
        "Testing en múltiples devices",
        "Performance optimization"
