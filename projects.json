{
  "projectMetadata": {
    "name": "Habit Tracker PWA",
    "description": "Progressive Web App para rastrear hábitos diarios con sincronización en tiempo real",
    "version": "1.0.0",
    "author": "Ricardo",
    "type": "next-pwa",
    "createdAt": "2026-08-04",
    "language": "TypeScript",
    "timezone": "America/Mexico_City"
  },

  "claudeCodeSetup": {
    "critical": "LEER PRIMERO - Setup de Claude Code",
    "caveman-mode-plugin": {
      "title": "Instalar Caveman Mode Plugin ANTES de ejecutar agentes",
      "commands": [
        "claude plugin marketplace add juliusbrussee/caveman",
        "claude plugin install caveman@caveman --scope project"
      ],
      "why": "Reduce token waste 40-50%, elimina filler text y recaps verbosos",
      "verification": "Claude Code responde de forma concisa, sin explicaciones largas"
    },
    "working-directory": {
      "step": "cd path/to/habits-tracker",
      "importance": "Crítico para que agentes tengan contexto correcto"
    }
  },

  "codeStyle": {
    "philosophy": "Caveman Coding - Minimalista, directo, auto-documentado",
    "comments": {
      "rule": "CERO COMENTARIOS EN EL CODIGO",
      "why": "El código debe ser auto-explicativo. Nombres claros reemplazan comentarios.",
      "exceptions": "Ninguna"
    },
    "naming": {
      "variables": "camelCase, máximo 3 palabras, descriptivo",
      "functions": "camelCase, verbo + sustantivo, describe la acción",
      "constants": "UPPER_SNAKE_CASE",
      "components": "PascalCase",
      "avoid": ["Una letra (a, b, x)", "Abreviaturas (cnt, arr, tmp)", "Genéricos (data, value, result)"]
    },
    "functions": {
      "maxLines": 20,
      "rule": "Si > 20 líneas, divide en sub-funciones",
      "structure": "Una responsabilidad, tipos explícitos"
    },
    "files": {
      "maxLines": 300,
      "componentMaxLines": 150,
      "rule": "Si excede, divide en subfolder o archivo separado"
    },
    "geometry": {
      "borderRadius": "CERO en todo. rounded-none explícito siempre.",
      "principle": "Bordes cuadrados son identidad de diseño. Imposibilitar redondos por accidente.",
      "applies-to": ["buttons", "cards", "inputs", "selects", "modals", "chips", "badges", "toggles", "dropdowns"]
    },
    "motion": {
      "rule": "CERO animaciones. State changes instantáneos.",
      "forbidden": ["transition-*", "animate-*", "keyframes", "spinners", "skeleton shimmer", "animation libraries"],
      "feedback": "Toast pattern únicamente. Auto-dismiss 4s, stacking, role=status o role=alert.",
      "loadingStates": "Texto estático o bloque sólido. Nunca spinner."
    }
  },

  "agentInstructions": {
    "forAllAgents": {
      "prerequisite": "Caveman Mode plugin instalado",
      "rule1": "CERO COMENTARIOS EN CODIGO",
      "rule2": "Caveman coding (auto-documentado)",
      "rule3": "Nombres descriptivos, específicos",
      "rule4": "TypeScript STRICT MODE",
      "rule5": "Funciones < 20 líneas",
      "rule6": "Respuestas directas, sin explicaciones largas ni resúmenes",
      "readFirst": [
        "project.json (este archivo)",
        ".claude-spec/AGENT_COORDINATION.md",
        "specs relevantes al rol"
      ]
    },
    "backend": {
      "name": "Agent Backend",
      "responsibility": "Types, Supabase client, queries, API routes. NO toca UI ni componentes.",
      "note": "El schema SQL ya está desplegado en Supabase. No generar migraciones.",
      "executionOrder": [
        "1. lib/types.ts (DefaultCategory, DefaultTag, Category, Tag, Activity, UserSettings, ActivityInput, ReportFilters)",
        "2. lib/supabase.ts",
        "3. lib/db-queries.ts",
        "4. app/api/settings/language/route.ts (GET, PUT)",
        "5. app/api/activities/route.ts (GET, POST)",
        "6. app/api/activities/[id]/route.ts (PUT, DELETE)",
        "7. app/api/categories/route.ts (GET, POST)",
        "8. app/api/categories/[id]/route.ts (PUT, DELETE)",
        "9. app/api/tags/route.ts (GET, POST)",
        "10. app/api/tags/[id]/route.ts (PUT, DELETE)",
        "11. app/api/reports/filter/route.ts (POST)",
        "12. app/api/bootstrap/route.ts (POST, idempotente, verificación por tabla)"
      ],
      "criticalValidations": [
        "title: requerido, 1-255 chars, rechazar vacío o solo espacios",
        "rating: INT 0-5, rechazar fuera de rango",
        "end_time estrictamente posterior a start_time",
        "Máximo 7 categorías por usuario (4 default + 3 custom), rechazar la octava",
        "Toda query scopeada al usuario autenticado",
        "Bootstrap: categorías antes que tags, tags por id real nunca por nombre"
      ],
      "specs": [
        ".claude-spec/DATABASE_SCHEMA.md",
        ".claude-spec/API_ENDPOINTS.md",
        ".claude-spec/AGENT_COORDINATION.md"
      ],
      "validation": "npx tsc --noEmit sin errores"
    },
    "frontend": {
      "name": "Agent Frontend",
      "responsibility": "Componentes, páginas, i18n, estado. NO toca app/api/ ni lib/types.ts.",
      "executionOrder": [
        "1. tailwind.config.ts (tokens semánticos, borderRadius DEFAULT '0')",
        "2. app/globals.css",
        "3. lib/translations/en.json y es.json",
        "4. lib/translations/categoryNames.ts",
        "5. lib/i18n/LanguageContext.tsx",
        "6. lib/locale-utils.ts",
        "7. lib/store.ts",
        "8. app/layout.tsx (ThemeProvider, LanguageProvider, ToastProvider)",
        "9. components/BootstrapGate.tsx (envuelve rutas autenticadas)",
        "10. components/Toast.tsx y ToastProvider",
        "11. Atoms: Button, Input, Select, TimePicker, DatePicker, RatingStars, Badge",
        "12. Molecules: CategorySelector, TagSelector, ActivityForm, ActivityCard, ReportFilters, LanguageToggle, ThemeToggle",
        "13. Organisms: DailyActivitiesList, CategoriesPanel, ReportResults, AuthForm",
        "14. Pages: auth/login, auth/signup, page.tsx, activities/add, activities/[id]/edit, reports, categories, settings"
      ],
      "criticalValidations": [
        "rounded-none explícito en cada contenedor",
        "Cero transition-* y animate-*, sin librerías de animación",
        "Todo string visible pasa por t(), sin texto hardcodeado",
        "Datos creados por el usuario nunca se traducen",
        "Tokens semánticos de color, nunca bg-[#hex]",
        "dark: en el mismo elemento, nunca markup duplicado",
        "Layout no rompe a 390px en español (strings 20-30% más largos)"
      ],
      "specs": [
        ".claude-spec/COMPONENT_SPEC.md",
        ".claude-spec/DESIGN_SYSTEM.md",
        ".claude-spec/MULTILANGUAGE.md",
        ".claude-spec/AGENT_COORDINATION.md"
      ],
      "validation": "npx tsc --noEmit sin errores"
    }
  },

  "database": {
    "provider": "Supabase",
    "status": "Schema desplegado. No generar migraciones.",
    "readOnlyTables": {
      "default_categories": {
        "purpose": "Repositorio global de categorías predefinidas, sin user_id",
        "fields": ["id (UUID, PK)", "key (VARCHAR 50, UNIQUE)", "name (VARCHAR 100)", "color (VARCHAR 7)", "created_at"],
        "seed": [
          { "key": "study", "name": "Study", "color": "#2563eb" },
          { "key": "exercise", "name": "Exercise", "color": "#16a34a" },
          { "key": "personals", "name": "Personal Improvement", "color": "#ea580c" },
          { "key": "spaces", "name": "Spaces", "color": "#7c3aed" }
        ]
      },
      "default_tags": {
        "purpose": "Repositorio global de tags, relación 1:N con default_categories",
        "fields": ["id (UUID, PK)", "default_category_id (FK)", "name (VARCHAR 50)", "color (VARCHAR 7)", "created_at"],
        "seedCount": 19,
        "seedByCategory": {
          "exercise": ["gym", "yoga", "pilates", "running", "dog walks", "treadmill", "hike"],
          "study": ["leetcode", "aws", "nodejs", "react", "php"],
          "personals": ["meditation", "socialization", "psychology", "reading"],
          "spaces": ["cleaning", "cooking", "decluttering"]
        }
      }
    },
    "userTables": {
      "categories": {
        "purpose": "Categorías del usuario (copias de default + custom), 1:N con tags",
        "fields": ["id (UUID, PK)", "user_id (FK auth.users)", "name (VARCHAR 100)", "color (VARCHAR 7)", "is_default (BOOLEAN)", "created_at", "updated_at"],
        "constraint": "UNIQUE(user_id, name), máximo 7 por usuario"
      },
      "tags": {
        "purpose": "Tags del usuario, 1:N con categories",
        "fields": ["id (UUID, PK)", "user_id (FK auth.users)", "category_id (FK categories)", "name (VARCHAR 50)", "color (VARCHAR 7)", "created_at", "updated_at"],
        "constraint": "UNIQUE(user_id, category_id, name)"
      },
      "activities": {
        "purpose": "Registro de actividades con título, rango de tiempo y rating",
        "fields": ["id (UUID, PK)", "user_id (FK)", "category_id (FK)", "tag_id (FK, nullable)", "title (VARCHAR 255, NOT NULL)", "start_time (TIMESTAMPTZ)", "end_time (TIMESTAMPTZ)", "duration_minutes (INT, GENERATED)", "rating (INT 0-5)", "notes (TEXT)", "activity_date (DATE)", "created_at", "updated_at"],
        "constraints": ["end_time > start_time", "rating BETWEEN 0 AND 5"]
      },
      "user_settings": {
        "purpose": "Preferencias de usuario",
        "fields": ["id (UUID, PK)", "user_id (UUID, UNIQUE, FK)", "language ('en' | 'es', default 'en')", "theme ('light' | 'dark' | 'system', default 'system')", "created_at", "updated_at"]
      }
    },
    "seeding": {
      "strategy": "Deferred - en primera carga autenticada, NO en signup",
      "why": "En signup no hay sesión establecida, auth.uid() es null, RLS rechaza los inserts",
      "endpoint": "POST /api/bootstrap",
      "verification": "Por tabla separada, no asumir que categorías implica tags completos",
      "ordering": "Categorías primero, capturar ids reales, después tags por id",
      "idempotent": true,
      "noTrigger": "No hay trigger en auth.users, no se usa security definer ni service role key"
    },
    "security": {
      "authentication": "Supabase Auth (email + password)",
      "authorization": "Row Level Security en todas las tablas de usuario",
      "policy": "auth.uid() = user_id"
    }
  },

  "multiLanguage": {
    "supported": ["en", "es"],
    "default": "en",
    "detection": "user_settings.language, luego navigator.language, fallback en",
    "storage": "user_settings.language",
    "architecture": {
      "database": "Siempre inglés para datos default",
      "frontend": "Traduce UI y nombres default según language activo",
      "userCreatedData": "Se guarda y muestra tal cual, nunca se traduce",
      "dates": "Intl.DateTimeFormat con locale derivado (en-US 12h, es-ES 24h)"
    },
    "changeLanguage": "Persiste a user_settings, luego reload de página",
    "specs": ".claude-spec/MULTILANGUAGE.md"
  },

  "ui": {
    "framework": "Next.js 15 + React 19",
    "styling": "Tailwind CSS v3",
    "darkMode": {
      "enabled": true,
      "library": "next-themes",
      "attribute": "class",
      "default": "system"
    },
    "designPrinciples": [
      "Minimalista: sin gradientes, sin drop shadows, sin glassmorphism",
      "Fricción mínima: 2-3 taps por acción",
      "Colores vibrantes y contrastantes",
      "Bordes cuadrados (identidad de diseño)",
      "Cero animaciones, feedback vía toast",
      "Tipografía limitada, 2-3 pesos"
    ],
    "responsive": {
      "primary": "390px (phone)",
      "desktop": "Dashboard más ancho, filtros de reportes al lado en vez de apilados"
    }
  },

  "colors": {
    "description": "Paleta vibrante, contrastante, sin gradientes",
    "categories": {
      "study": { "light": "#2563eb", "dark": "#3b82f6" },
      "exercise": { "light": "#16a34a", "dark": "#22c55e" },
      "personals": { "light": "#ea580c", "dark": "#f97316" },
      "spaces": { "light": "#7c3aed", "dark": "#a78bfa" }
    },
    "semantic": {
      "success": { "light": "#059669", "dark": "#10b981" },
      "error": { "light": "#dc2626", "dark": "#ef4444" },
      "warning": { "light": "#d97706", "dark": "#f59e0b" },
      "info": { "light": "#0891b2", "dark": "#06b6d4" }
    },
    "rating": "#f59e0b",
    "lightMode": {
      "background": { "primary": "#ffffff", "secondary": "#f9fafb", "tertiary": "#f3f4f6" },
      "text": { "primary": "#111827", "secondary": "#374151", "tertiary": "#6b7280" },
      "border": { "light": "#e5e7eb", "medium": "#d1d5db", "strong": "#9ca3af" }
    },
    "darkMode": {
      "background": { "primary": "#0f172a", "secondary": "#1e293b", "tertiary": "#334155" },
      "text": { "primary": "#f1f5f9", "secondary": "#cbd5e1", "tertiary": "#94a3b8" },
      "border": { "light": "#334155", "medium": "#475569", "strong": "#64748b" }
    }
  },

  "api": {
    "baseUrl": "/api",
    "endpoints": {
      "bootstrap": {
        "seed": "POST /api/bootstrap (idempotente, retorna { seeded, categoriesCreated, tagsCreated })"
      },
      "activities": {
        "list": "GET /api/activities",
        "create": "POST /api/activities (body: title, category_id, tag_id?, start_time, end_time, rating?, notes?, activity_date?)",
        "update": "PUT /api/activities/[id]",
        "delete": "DELETE /api/activities/[id]"
      },
      "categories": {
        "list": "GET /api/categories",
        "create": "POST /api/categories (body: name, color)",
        "update": "PUT /api/categories/[id]",
        "delete": "DELETE /api/categories/[id]"
      },
      "tags": {
        "list": "GET /api/tags",
        "create": "POST /api/tags (body: category_id, name, color?)",
        "update": "PUT /api/tags/[id]",
        "delete": "DELETE /api/tags/[id]"
      },
      "reports": {
        "filter": "POST /api/reports/filter (body: startDate?, endDate?, categoryIds[], tagIds[], minRating?)"
      },
      "settings": {
        "getLanguage": "GET /api/settings/language",
        "setLanguage": "PUT /api/settings/language (body: language)"
      }
    }
  },

  "pages": {
    "public": [
      "app/auth/login/page.tsx",
      "app/auth/signup/page.tsx"
    ],
    "authenticated": [
      "app/page.tsx (Dashboard)",
      "app/activities/add/page.tsx",
      "app/activities/[id]/edit/page.tsx",
      "app/reports/page.tsx",
      "app/categories/page.tsx",
      "app/settings/page.tsx"
    ],
    "note": "Todas las rutas autenticadas renderizan dentro de BootstrapGate"
  },

  "components": {
    "providers": ["LanguageProvider", "ThemeProvider", "ToastProvider", "BootstrapGate"],
    "atoms": ["Button", "Input", "Select", "TimePicker", "DatePicker", "RatingStars", "Badge", "Toast"],
    "molecules": ["CategorySelector", "TagSelector", "ActivityForm", "ActivityCard", "ReportFilters", "LanguageToggle", "ThemeToggle"],
    "organisms": ["DailyActivitiesList", "CategoriesPanel", "ReportResults", "AuthForm"]
  },

  "dependencies": {
    "core": {
      "next": "^15.0.0",
      "react": "^19.0.0",
      "react-dom": "^19.0.0",
      "typescript": "^5.0.0"
    },
    "database": { "@supabase/supabase-js": "^2.38.0" },
    "ui": { "tailwindcss": "^3.3.0", "next-themes": "^0.2.1" },
    "state": { "zustand": "^4.4.0" },
    "pwa": { "next-pwa": "^5.6.0" },
    "utilities": { "clsx": "^2.0.0", "date-fns": "^2.30.0" }
  },

  "deployment": {
    "frontend": {
      "platform": "Vercel",
      "environment": ["NEXT_PUBLIC_SUPABASE_URL", "NEXT_PUBLIC_SUPABASE_ANON_KEY"],
      "preview": "Automático con cada push",
      "production": "Main branch"
    },
    "database": { "platform": "Supabase" },
    "pwa": { "installable": true, "manifest": "public/manifest.json" },
    "cost": "$0/mes (Vercel + Supabase tier gratuito)"
  },

  "fileStructure": {
    "root": ["app/", "components/", "lib/", "public/", ".claude-spec/", ".env.local", "package.json", "project.json", "tsconfig.json", "tailwind.config.ts", "next.config.ts"],
    "lib": ["supabase.ts", "db-queries.ts", "types.ts", "store.ts", "locale-utils.ts", "i18n/", "translations/"],
    ".claude-spec": [
      "DATABASE_SCHEMA.md",
      "API_ENDPOINTS.md",
      "COMPONENT_SPEC.md",
      "DESIGN_SYSTEM.md",
      "MULTILANGUAGE.md",
      "AGENT_COORDINATION.md",
      "COLOR_SCHEME.md",
      "screens/"
    ]
  },

  "notes": {
    "critical": [
      "Instalar Caveman Mode plugin ANTES de ejecutar agentes",
      "CERO COMENTARIOS en código",
      "Bordes cuadrados: rounded-none explícito",
      "Cero animaciones, feedback solo vía toast",
      "Seeding ocurre en primera carga autenticada, NO en signup (RLS bloquea antes de la sesión)",
      "Title es obligatorio en activities, 1-255 chars",
      "Máximo 7 categorías por usuario (4 default + 3 custom)",
      "Multiidioma: UI y nombres default traducen, datos del usuario NO"
    ],
    "reminders": [
      "Agent Backend termina ANTES de Agent Frontend",
      "Bootstrap: categorías antes que tags, referencias por id real nunca por nombre",
      "Bootstrap corre en cada mount autenticado, es idempotente",
      "Un bootstrap fallido no debe bloquear la app",
      "Cambio de idioma requiere reload",
      "Toast: role=status para éxito, role=alert para error",
      "Validar layout a 390px en ambos idiomas"
    ],
    "knownFailures": [
      "El seed en signup falla silenciosamente por RLS: sin sesión, auth.uid() es null",
      "Un helper generado por un agente y llamado por otro se pierde si ningún spec lo nombra"
    ]
  }
}